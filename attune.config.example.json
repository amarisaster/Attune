{
  "_comment": "Copy this file to attune.config.json (gitignored) and fill in your own values. Every key is optional -- env vars (ATTUNE_*) override these, and unset values fall back to the defaults documented in README.md's Configuration section.",

  "port": 8452,

  "token_file": "~/.attune-token",

  "ffmpeg_dir": "",

  "allowed_audio_prefixes": [
    "https://your-project.supabase.co/storage/v1/object/public/your-bucket/"
  ],

  "stt_mode": "local",
  "whisper_model": "base.en",

  "stt_url": "https://your-stt-service.example.com/api/stt",
  "stt_token_file": "~/.attune-stt-token",
  "stt_max_bytes": 6291456,
  "stt_chunk_seconds": 28,
  "stt_chunk_overlap_seconds": 2,
  "stt_max_chunks": 20,
  "stt_silence_dbfs": -50.0,

  "max_upload_bytes": 52428800,
  "max_transcript_chars": 16384,

  "drops_dir": "./drops",
  "drops_keep": 200,
  "public_base_url": "https://your-host.example.com",

  "encounter_db": "~/.attune/encounters.sqlite",
  "encounter_listener_id": "default-listener"
}
